ErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"40"},"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\index.js",[],["81","82"],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\App.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\ScrollToTop.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Pre.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Navbar.js",["83"],"import React, { useState } from \"react\";\nimport Navbar from \"react-bootstrap/Navbar\";\nimport Nav from \"react-bootstrap/Nav\";\nimport Container from \"react-bootstrap/Container\";\nimport Button from \"react-bootstrap/Button\";\nimport { Link } from \"react-router-dom\";\nimport { CgGitFork } from \"react-icons/cg\";\nimport {\n  AiFillStar,\n  AiOutlineHome,\n  AiOutlineFundProjectionScreen,\n  AiOutlineUser,\n} from \"react-icons/ai\";\nimport { ImBlog } from \"react-icons/im\";\nimport { CgFileDocument } from \"react-icons/cg\";\n\nfunction NavBar() {\n  const [expand, updateExpanded] = useState(false);\n  const [navColour, updateNavbar] = useState(false);\n\n  function scrollHandler() {\n    if (window.scrollY >= 20) {\n      updateNavbar(true);\n    } else {\n      updateNavbar(false);\n    }\n  }\n\n  window.addEventListener(\"scroll\", scrollHandler);\n\n  return (\n    <Navbar\n      expanded={expand}\n      fixed=\"top\"\n      expand=\"md\"\n      className={navColour ? \"sticky\" : \"navbar\"}\n    >\n      <Container>\n        <Navbar.Brand as={Link} to=\"/\">\n          <p\n            style={{\n              color: \"#be50f4\",\n              margin: \"auto\",\n              fontWeight: \"700\",\n              letterSpacing: \"1px\",\n              fontSize: \"28px\",\n            }}\n          >\n            Mitul Chaudhary\n          </p>\n        </Navbar.Brand>\n        <Navbar.Toggle\n          aria-controls=\"responsive-navbar-nav\"\n          onClick={() => {\n            updateExpanded(expand ? false : \"expanded\");\n          }}\n        >\n          <span></span>\n          <span></span>\n          <span></span>\n        </Navbar.Toggle>\n        <Navbar.Collapse id=\"responsive-navbar-nav\">\n          <Nav className=\"ml-auto\" defaultActiveKey=\"#home\">\n            <Nav.Item>\n              <Nav.Link as={Link} to=\"/\" onClick={() => updateExpanded(false)}>\n                <AiOutlineHome style={{ marginBottom: \"2px\" }} /> Home\n              </Nav.Link>\n            </Nav.Item>\n\n            <Nav.Item>\n              <Nav.Link\n                as={Link}\n                to=\"/about\"\n                onClick={() => updateExpanded(false)}\n              >\n                <AiOutlineUser style={{ marginBottom: \"2px\" }} /> About\n              </Nav.Link>\n            </Nav.Item>\n\n            <Nav.Item>\n              <Nav.Link\n                as={Link}\n                to=\"/project\"\n                onClick={() => updateExpanded(false)}\n              >\n                <AiOutlineFundProjectionScreen\n                  style={{ marginBottom: \"2px\" }}\n                />{\" \"}\n                Projects\n              </Nav.Link>\n            </Nav.Item>\n\n            <Nav.Item>\n              <Nav.Link\n                as={Link}\n                to=\"/resume\"\n                onClick={() => updateExpanded(false)}\n              >\n                <CgFileDocument style={{ marginBottom: \"2px\" }} /> Resume\n              </Nav.Link>\n            </Nav.Item>\n\n            <Nav.Item className=\"fork-btn\">\n              <Button\n                href=\"https://github.com\"\n                target=\"_blank\"\n                className=\"fork-btn-inner\"\n              >\n                <CgGitFork style={{ fontSize: \"1.2em\" }} />{\" \"}\n                <AiFillStar style={{ fontSize: \"1.1em\" }} />\n              </Button>\n            </Nav.Item>\n          </Nav>\n        </Navbar.Collapse>\n      </Container>\n    </Navbar>\n  );\n}\n\nexport default NavBar;\n","C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Footer.js",["84","85"],"import React from \"react\";\nimport { Container, Row, Col } from \"react-bootstrap\";\nimport {\n  AiFillGithub,\n  AiOutlineTwitter,\n  AiFillInstagram,\n} from \"react-icons/ai\";\nimport { FaLinkedinIn } from \"react-icons/fa\";\n\nfunction Footer() {\n  let date = new Date();\n  let year = date.getFullYear();\n  return (\n    <Container fluid className=\"footer\">\n      <Row>\n        <Col md=\"4\" className=\"footer-copywright\">\n          <h3>Designed and Developed by Mitul Chaudhary</h3>\n        </Col>\n        <Col md=\"4\" className=\"footer-copywright\">\n          <h3>Copyright © {year} MC</h3>\n        </Col>\n        <Col md=\"4\" className=\"footer-body\">\n          <ul className=\"footer-icons\">\n            <li className=\"social-icons\">\n              <a\n                href=\"https://github.com\"\n                style={{ color: \"white\" }}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n              >\n                <AiFillGithub />\n              </a>\n            </li>\n\n            <li className=\"social-icons\">\n              <a\n                href=\"https://www.linkedin.com/in/mitul-chaudhari-7ab61b37a\"\n                style={{ color: \"white\" }}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n              >\n                <FaLinkedinIn />\n              </a>\n            </li>\n          </ul>\n        </Col>\n      </Row>\n    </Container>\n  );\n}\n\nexport default Footer;\n","C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\About\\About.js",["86"],"import React, { useEffect } from \"react\";\nimport { Container, Row, Col } from \"react-bootstrap\";\nimport Particle from \"../Particle\";\nimport Techstack from \"./Techstack\";\nimport Aboutcard from \"./AboutCard\";\nimport laptopImg from \"../../Assets/about.png\";\nimport Toolstack from \"./Toolstack\";\n\nfunction About() {\n  return (\n    <Container fluid className=\"about-section\">\n      <Particle />\n      <Container>\n        <Row style={{ justifyContent: \"center\", padding: \"10px\" }}>\n          <Col\n            md={7}\n            style={{\n              justifyContent: \"center\",\n              paddingTop: \"30px\",\n              paddingBottom: \"50px\",\n            }}\n          >\n            <h1 style={{ fontSize: \"2.1em\", paddingBottom: \"20px\" }}>\n              Know Who <strong className=\"purple\">I'M</strong>\n            </h1>\n            <Aboutcard />\n          </Col>\n          <Col\n            md={5}\n            style={{ paddingTop: \"120px\", paddingBottom: \"50px\" }}\n            className=\"about-img\"\n          >\n            <img src={laptopImg} alt=\"about\" className=\"img-fluid\" />\n          </Col>\n        </Row>\n        <h1 className=\"project-heading\">\n          Professional <strong className=\"purple\">Skillset </strong>\n        </h1>\n\n        <Techstack />\n\n        <h1 className=\"project-heading\">\n          <strong className=\"purple\">Tools</strong> I use\n        </h1>\n        <Toolstack />\n      </Container>\n    </Container>\n  );\n}\n\nexport default About;\n","C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Projects\\Projects.js",["87","88"],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Home\\Home.js",["89"],"import React, { useEffect } from \"react\";\nimport { Container, Row, Col } from \"react-bootstrap\";\nimport homeLogo from \"../../Assets/home-main.svg\";\nimport Particle from \"../Particle\";\nimport Home2 from \"./Home2\";\nimport Type from \"./Type\";\n\nfunction Home() {\n  return (\n    <section>\n      <Container fluid className=\"home-section\" id=\"home\">\n        <Particle />\n        <Container className=\"home-content\">\n          <Row>\n            <Col md={7} className=\"home-header\">\n              <h1 style={{ paddingBottom: 15 }} className=\"heading\">\n                Hi There!{\" \"}\n                <span className=\"wave\" role=\"img\" aria-labelledby=\"wave\">\n                  👋🏻\n                </span>\n              </h1>\n\n              <h1 className=\"heading-name\">\n                I'M\n                <strong className=\"main-name\"> MITUL CHAUDHARY </strong>\n              </h1>\n\n              <div style={{ padding: 50, textAlign: \"left\" }}>\n                <Type />\n              </div>\n            </Col>\n\n            <Col md={5} style={{ paddingBottom: 20 }}>\n              <img src={homeLogo} alt=\"home pic\" className=\"img-fluid\" />\n            </Col>\n          </Row>\n        </Container>\n      </Container>\n      <Home2 />\n    </section>\n  );\n}\n\nexport default Home;\n","C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Resume\\Resume.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\About\\Techstack.js",["90"],"import React from \"react\";\nimport { Col, Row } from \"react-bootstrap\";\nimport { CgCPlusPlus } from \"react-icons/cg\";\nimport { DiJavascript1, DiReact, DiNodejs, DiMongodb } from \"react-icons/di\";\nimport { SiCss3, SiHtml5 } from \"react-icons/si\";\n\nfunction Techstack() {\n  return (\n    <Row style={{ justifyContent: \"center\", paddingBottom: \"50px\" }}>\n      <Col xs={4} md={2} className=\"tech-icons\">\n        <SiHtml5 />\n        <SiCss3 />\n      </Col>\n      <Col xs={4} md={2} className=\"tech-icons\">\n        <DiJavascript1 />\n      </Col>\n      <Col xs={4} md={2} className=\"tech-icons\">\n        <DiNodejs size={120} />\n      </Col>\n      <Col xs={4} md={2} className=\"tech-icons\">\n        <DiReact />\n      </Col>\n      <Col xs={4} md={2} className=\"tech-icons\">\n        <DiMongodb />\n      </Col>\n    </Row>\n  );\n}\n\nexport default Techstack;\n","C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\About\\Toolstack.js",["91","92"],"import React from \"react\";\nimport { Col, Row } from \"react-bootstrap\";\nimport {\n  SiLinux,\n  SiVisualstudiocode,\n  SiPostman,\n  SiHeroku,\n} from \"react-icons/si\";\nimport { IoLogoVercel } from \"react-icons/io5\";\n\nfunction Toolstack() {\n  return (\n    <Row style={{ justifyContent: \"center\", paddingBottom: \"50px\" }}>\n      <Col xs={4} md={2} className=\"tech-icons\">\n        <SiLinux />\n      </Col>\n      <Col xs={4} md={2} className=\"tech-icons\">\n        <SiVisualstudiocode />\n      </Col>\n      <Col xs={4} md={2} className=\"tech-icons\">\n        <IoLogoVercel />\n      </Col>\n    </Row>\n  );\n}\n\nexport default Toolstack;\n","C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Projects\\ProjectCards.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Resume\\ResumeContent.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\About\\AboutCard.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Home\\Type.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Particle.js",[],"C:\\Users\\hmc12\\Downloads\\portfolio-master\\portfolio-master\\src\\components\\Home\\Home2.js",[],{"ruleId":"93","replacedBy":"94"},{"ruleId":"95","replacedBy":"96"},{"ruleId":"97","severity":1,"message":"98","line":14,"column":10,"nodeType":"99","messageId":"100","endLine":14,"endColumn":16},{"ruleId":"97","severity":1,"message":"101","line":5,"column":3,"nodeType":"99","messageId":"100","endLine":5,"endColumn":19},{"ruleId":"97","severity":1,"message":"102","line":6,"column":3,"nodeType":"99","messageId":"100","endLine":6,"endColumn":18},{"ruleId":"97","severity